# Get your free API key from Google AI Studio:
#rename this file to .env and replace the value of GEMINI_API_KEY with your actual API key.
#get your api key here 👇
# https://aistudio.google.com/apikey

GEMINI_API_KEY=your_gemini_api_key_here

# Optional (change the port number if you want to run the server on a different port.)
PORT=3000
